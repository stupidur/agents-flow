{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "figma-developer-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp",
        "--stdio"
      ],
      "environment": {
        "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
      },
      "enabled": true
    },
    "figma-desktop-mcp": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": false
    }
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ]
}
